DATABASE_URL=postgres://tgm:tgm@localhost:5432/tgm
# бот по умолчанию для ГЛАВНОГО администратора (необязательно): остальные подключают своих ботов на странице «Бот»
BOT_TOKEN=

# Публичный HTTPS-адрес приложения, без слэша в конце. Если задан, боты получают события (лайки) от Telegram
# через webhook на PUBLIC_URL/api/telegram/<id>: не нужен постоянный опрос Telegram, это экономит ресурсы.
# Telegram принимает webhook только по HTTPS (порты 443, 80, 88, 8443) и с валидным сертификатом.
# Если не задан (разработка на localhost), боты работают через long polling.
# PUBLIC_URL=https://tgm.example.com
# Принудительно включить polling, даже если задан PUBLIC_URL (auto | polling)
# BOT_MODE=auto
# ключ шифрования токенов ботов в БД: 32 байта, например `openssl rand -base64 32` (обязателен для подключения ботов)
SECRETS_KEY=
# самостоятельная регистрация администраторов (по умолчанию включена): false — отключить
ALLOW_REGISTRATION=true
# код-приглашение для регистрации (необязательно; если задан, без него зарегистрироваться нельзя)
REGISTRATION_CODE=
# true, если приложение стоит за reverse proxy с HTTPS (нужно для secure-cookie)
TRUST_PROXY=false
# только для npm run seed: логин/пароль демо-администратора (пароль, если не задан, генерируется)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
